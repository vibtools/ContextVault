    "technology": {
        "languages": [
            "Python"
        ],
        "frameworks": [
            "CustomTkinter"
        ],
        "libraries": [
            "Playwright",
            "BeautifulSoup4",
            "Markdownify",
            "Pillow",
            "Pydantic",
            "Tenacity"
        ],
        "packageManagers": [
            "pip"
        ],
        "databases": [],
        "apis": []
