    "runtime": {
        "python": "3.12+",
        "node": "",
        "docker": false,
        "container": "",
        "distribution": "Nuitka OneDir",
        "browser": "Google Chrome Stable",
        "browserAutomation": "Playwright",
        "browserProfile": "ContextVault-managed persistent Chrome profile",
        "browserExtensions": true,
        "runtimeDirectory": "runtime/"
    },
    "entrypoints": {
        "application": "src/app.py",
        "cli": "",
        "api": "",
        "documentation": "docs/index.md",
        "tests": "tests/"
    },
    "paths": {
        "source": "src/",
        "tests": "tests/",
        "documentation": "docs/",
        "scripts": "scripts/",
        "assets": "assets/",
        "examples": "examples/",
        "configuration": "config/",
        "data": "data/",
        "project": "docs/"
    },
    "dependencies": {
        "required": [
            "customtkinter",
            "playwright",
            "beautifulsoup4",
            "markdownify",
            "Pillow",
            "pydantic",
            "tenacity"
        ],
        "optional": [],
