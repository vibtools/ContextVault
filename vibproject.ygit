    "documentation": {
        "readme": "README.md",
        "structure": "PROJECT_STRUCTURE.md",
        "changelog": "CHANGELOG.md",
        "license": "LICENSE",
        "docsRoot": "docs/",
        "website": "https://github.com/vibtools/ContextVault/tree/main/docs"
    },
    "build": {
        "buildSystem": "Nuitka",
        "packageFormat": [
            "ZIP",
            "OneDir"
        ],
        "commands": {
            "install": "python -m pip install -r requirements.lock",
            "build": "python scripts/build/build_windows.py",
            "test": "python scripts/test/run_tests.py",
            "lint": "python -m compileall -q src scripts tests",
            "format": ""
        }
    },
    "release": {
        "strategy": "GitHub Releases",
        "versioning": "Semantic Versioning",
        "latestVersion": "0.2.0",
        "releaseNotes": "docs/release-notes/"
    },
    "quality": {
        "formatter": "EditorConfig",
        "linter": "AST and compile audit",
        "testFramework": "unittest",
        "coverage": "behavioral release-gate suite",
        "security": [
            "path validation",
            "atomic writes",
            "SHA-256 integrity",
            "locked dependencies"
        ]
    },
    "automation": {
        "ci": "GitHub Actions",
        "cd": "GitHub Releases",
        "workflows": [
